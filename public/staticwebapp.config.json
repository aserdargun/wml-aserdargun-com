{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.svg",
      "/release.json"
    ]
  },
  "globalHeaders": {
"X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".wasm": "application/wasm"
  },
  "routes": [
    {
      "route": "/release.json",
      "headers": {
        "Cache-Control": "no-store"
      }
    }
  ]
}
